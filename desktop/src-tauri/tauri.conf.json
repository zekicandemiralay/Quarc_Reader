{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quarc Reader",
  "version": "1.0.0",
  "identifier": "com.quarc.reader",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "https://quarcnet0.tail84500c.ts.net:4008",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Quarc",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quarc Reader",
        "url": "https://quarcnet0.tail84500c.ts.net:4008",
        "width": 1100,
        "height": 650,
        "minWidth": 900,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
