# Must be IDENTICAL to the JWT_SECRET used by the quarc-auth service (see
# Quarc_Store/auth/.env) and by every other Quarc app's .env — that's what makes
# one login work across every Quarc app.
JWT_SECRET=change-this-to-a-long-random-string

# Must match quarc-auth's SECURE_COOKIE (default true: the apps are served over HTTPS).
SECURE_COOKIE=true

# The largest PDF one upload may be, in bytes (default 2 GB).
# MAX_FILE_BYTES=2147483648

# Optional: the most one account may store in total, in bytes (unset = unlimited).
# MAX_USER_BYTES=21474836480
